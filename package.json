{
  "name": "@blackroad/graphql-server",
  "version": "1.0.0",
  "description": "BlackRoad GraphQL Server - Unified API Gateway for Projects, CRM, and Multi-Cloud Integrations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "generate": "graphql-codegen",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "hash:test": "tsx src/utils/hash/test.ts",
    "agents:setup": "tsx src/agents/setup.ts"
  },
  "keywords": [
    "blackroad",
    "graphql",
    "api-gateway",
    "salesforce",
    "cloudflare",
    "vercel",
    "digitalocean",
    "anthropic",
    "claude",
    "crm",
    "projects",
    "sha256",
    "multi-cloud"
  ],
  "author": "BlackRoad OS, Inc. <blackroad.systems@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackRoad-OS/blackroad-graphql-server.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@apollo/server": "^4.11.0",
    "@as-integrations/fastify": "^2.1.0",
    "@octokit/rest": "^20.0.2",
    "@prisma/client": "^5.19.0",
    "axios": "^1.7.0",
    "cloudflare": "^3.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.23.0",
    "ioredis": "^5.4.0",
    "jsforce": "^2.0.0-beta.29",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-resolvers": "^4.2.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "prisma": "^5.19.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "blackroad": {
    "category": "infrastructure",
    "tier": "core",
    "integrations": [
      "cloudflare",
      "salesforce",
      "vercel",
      "digitalocean",
      "anthropic",
      "github",
      "termius",
      "ios-tools"
    ],
    "features": [
      "projects",
      "crm-state",
      "sha-infinity",
      "agent-system"
    ]
  }
}
