# =============================================================================
# BlackRoad GraphQL Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration (Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/blackroad_graphql?schema=public"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
API_KEY_SALT=your-api-key-salt-for-hashing

# -----------------------------------------------------------------------------
# Cloudflare Integration
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id

# -----------------------------------------------------------------------------
# Salesforce Integration
# -----------------------------------------------------------------------------
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_USERNAME=your-salesforce-username
SALESFORCE_PASSWORD=your-salesforce-password
SALESFORCE_SECURITY_TOKEN=your-salesforce-security-token
SALESFORCE_CLIENT_ID=your-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-connected-app-client-secret

# -----------------------------------------------------------------------------
# Vercel Integration
# -----------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=your-vercel-team-id
VERCEL_PROJECT_ID=your-vercel-project-id

# -----------------------------------------------------------------------------
# Digital Ocean Integration
# -----------------------------------------------------------------------------
DIGITALOCEAN_TOKEN=your-digitalocean-api-token
DIGITALOCEAN_SPACES_KEY=your-spaces-access-key
DIGITALOCEAN_SPACES_SECRET=your-spaces-secret-key
DIGITALOCEAN_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DIGITALOCEAN_SPACES_BUCKET=your-bucket-name

# -----------------------------------------------------------------------------
# Anthropic/Claude Integration
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_ORG=BlackRoad-OS
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Termius Integration
# -----------------------------------------------------------------------------
TERMIUS_API_KEY=your-termius-api-key
TERMIUS_TEAM_ID=your-termius-team-id

# -----------------------------------------------------------------------------
# iOS Tools Configuration (iSH, Shellfish, Working Copy, Pyto)
# -----------------------------------------------------------------------------
IOS_TOOLS_WEBHOOK_URL=https://your-webhook-endpoint.com/ios
IOS_TOOLS_API_KEY=your-ios-tools-api-key
WORKING_COPY_CALLBACK_URL=working-copy://x-callback-url

# -----------------------------------------------------------------------------
# BlackRoad Internal Services
# -----------------------------------------------------------------------------
BLACKROAD_API_URL=https://api.blackroad.io
BLACKROAD_API_KEY=your-blackroad-internal-api-key
BLACKROAD_CRM_ENDPOINT=https://crm.blackroad.io/api

# -----------------------------------------------------------------------------
# SHA-Infinity Hashing Configuration
# -----------------------------------------------------------------------------
SHA_INFINITY_ITERATIONS=10000
SHA_INFINITY_KEY_LENGTH=64
SHA_INFINITY_ALGORITHM=sha512

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_PROJECTS=true
ENABLE_CRM_SYNC=true
ENABLE_MULTI_CLOUD=true
ENABLE_AGENT_SYSTEM=true
ENABLE_SHA_INFINITY=true
